// =======================================================
// 超高速インメモリ ＆ ハンドル永久キャッシュ (0ms即引き)
// 改善版: ショート複数読み込み＆関連ショート自動取得対応
// =======================================================
const MEMORY_CACHE = new Map();
const CACHE_TTL_MS = 10 * 60 * 1000;   // 10分間は「新鮮」として即返却
const STALE_MAX_MS = 60 * 60 * 1000;   // 期限切れでも60分までは古いデータを即返却し、裏で更新
const CHANNEL_ID_CACHE = new Map();
const REFRESHING = new Set();          // 裏更新中のキー (二重更新防止)
let CACHE_ORIGIN = "https://cache.local";

// ★ ショート専用定数
const SHORTS_DEFAULT_LIMIT = 40;
const SHORTS_MAX_LIMIT = 120;
const SHORTS_MAX_SECONDS = 60;

function getCached(key) {
  const item = MEMORY_CACHE.get(key);
  if (item && Date.now() - item.time < CACHE_TTL_MS) {
    return item.data;
  }
  return null;
}

function getStale(key) {
  const item = MEMORY_CACHE.get(key);
  if (item && Date.now() - item.time < STALE_MAX_MS) {
    return item.data;
  }
  return null;
}

function setCache(key, data) {
  MEMORY_CACHE.delete(key);
  if (MEMORY_CACHE.size > 800) {
    const firstKey = MEMORY_CACHE.keys().next().value;
    MEMORY_CACHE.delete(firstKey);
  }
  MEMORY_CACHE.set(key, { data, time: Date.now() });
}

function getSearchContinuationKey(token) {
  return `search_cont_${token.replace(/[^a-zA-Z0-9_-]/g, "")}`;
}

function shortsPageKey(continuation, limit, maxSeconds) {
  return `shorts_page_${continuation.replace(/[^a-zA-Z0-9_-]/g, "")}_${limit}_${maxSeconds}`;
}

// ★ ショート複数取得関数 (改善版)
async function fetchMultipleShortsWithRelated(shortIds, options = {}) {
  const { limit = 40, maxSeconds = 60 } = options;
  
  // すべてのショートIDに対して並行リクエスト
  const promises = shortIds.map(id => 
    fetchShortDetails(id, maxSeconds).catch(() => null)
  );
  
  const results = await Promise.all(promises);
  const shorts = results.filter(s => s !== null);
  
  return {
    type: "shorts",
    shorts: shorts,
    count: shorts.length,
    timestamp: Date.now()
  };
}

// ★ 単一ショート詳細取得
async function fetchShortDetails(shortId, maxSeconds = 60) {
  try {
    // Invidiousから動画詳細を取得
    const response = await fetch(`https://invidious.io/api/v1/videos/${shortId}?fields=videoId,title,author,authorId,authorUrl,lengthSeconds,thumbnail,embedUrl,description,likeCount,viewCount,published`);
    
    if (!response.ok) return null;
    
    const data = await response.json();
    
    // 秒数制限チェック
    if (data.lengthSeconds > maxSeconds) return null;
    
    return {
      id: data.videoId,
      title: data.title || "",
      author: data.author || "",
      authorId: data.authorId || "",
      thumbnail: data.thumbnail || `https://i.ytimg.com/vi/${data.videoId}/hqdefault.jpg`,
      embedUrl: `https://www.youtube-nocookie.com/embed/${data.videoId}?autoplay=1&modestbranding=1`,
      duration: data.lengthSeconds || 0,
      likes: data.likeCount || 0,
      views: data.viewCount || 0,
      published: data.published || null,
      description: data.description || ""
    };
  } catch (e) {
    console.error(`Failed to fetch short ${shortId}:`, e.message);
    return null;
  }
}

// ★ ショート関連動画取得 (改善版: 複数取得)
async function fetchRelatedShorts(sourceShortId, limit = 30, maxSeconds = 60) {
  try {
    // Invidiousから関連動画を取得
    const response = await fetch(`https://invidious.io/api/v1/videos/${sourceShortId}?fields=recommendedVideos`);
    
    if (!response.ok) {
      console.error("Failed to fetch related videos");
      return [];
    }
    
    const data = await response.json();
    const recommended = data.recommendedVideos || [];
    
    // 最初のN件のIDを抽出
    const shortIds = recommended.slice(0, limit).map(r => r.videoId);
    
    if (shortIds.length === 0) return [];
    
    // 複数のショート詳細を並行取得
    const relatedShortsResponse = await fetchMultipleShortsWithRelated(shortIds, { limit, maxSeconds });
    return relatedShortsResponse.shorts || [];
  } catch (e) {
    console.error("Error fetching related shorts:", e.message);
    return [];
  }
}

// ★ 改善版: ショートフィード取得 (1つ + 関連ショート複数)
async function fetchShortsFeed(shortId, options = {}) {
  const { limit = 40, continuation = null, maxSeconds = 60 } = options;
  
  try {
    // 1. 指定されたショートの詳細を取得
    const currentShort = await fetchShortDetails(shortId, maxSeconds);
    
    if (!currentShort) {
      return {
        type: "shorts",
        error: `Short not found: ${shortId}`,
        current: null,
        sequence: [],
        continuation: null
      };
    }
    
    // 2. 関連ショートを取得 (複数)
    const relatedShorts = await fetchRelatedShorts(shortId, limit, maxSeconds);
    
    // 3. continuationの処理 (次ページがある場合)
    let nextContinuation = null;
    if (relatedShorts.length >= limit * 0.8) {
      // さらに関連ショートがある可能性がある
      nextContinuation = `${shortId}_page_${Date.now()}`;
    }
    
    return {
      type: "shorts",
      current: currentShort,
      sequence: relatedShorts,        // 関連ショートのリスト (複数)
      continuation: nextContinuation,
      totalRelated: relatedShorts.length,
      timestamp: Date.now()
    };
  } catch (e) {
    console.error("Error in fetchShortsFeed:", e.message);
    return {
      type: "shorts",
      error: e.message,
      current: null,
      sequence: [],
      continuation: null
    };
  }
}

// ★ ショート別シード取得
async function getShortsSeed() {
  try {
    // Invidiousから人気ショートを1件取得
    const response = await fetch("https://invidious.io/api/v1/trending?type=shorts&limit=1");
    if (!response.ok) return "9f1rHt0W_Ak";
    const data = await response.json();
    return data[0]?.videoId || "9f1rHt0W_Ak";
  } catch {
    return "9f1rHt0W_Ak";
  }
}

function triggerShortsPrefetch(ctx, targetId, continuation, limit, maxSeconds) {
  if (REFRESHING.has(continuation)) return;
  REFRESHING.add(continuation);
  
  ctx.waitUntil(
    (async () => {
      try {
        const relatedShorts = await fetchRelatedShorts(targetId, limit, maxSeconds);
        const pageKey = shortsPageKey(continuation, limit, maxSeconds);
        setCache(pageKey, { sequence: relatedShorts, continuation: null });
      } finally {
        REFRESHING.delete(continuation);
      }
    })()
  );
}

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    CACHE_ORIGIN = url.origin;

    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers": "*",
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400",
      "Referrer-Policy": "no-referrer"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    const path = url.pathname;
    const cacheKey = url.pathname + url.search;

    let shortId = url.searchParams.get("short") || url.searchParams.get("shorts");
    const shortsLimit = Math.max(1, Math.min(parseInt(url.searchParams.get("limit") || String(SHORTS_DEFAULT_LIMIT), 10) || SHORTS_DEFAULT_LIMIT, SHORTS_MAX_LIMIT));
    const maxSecondsRaw = parseInt(url.searchParams.get("maxSeconds") || url.searchParams.get("maxLength") || "", 10);
    const shortsMaxSeconds = maxSecondsRaw > 0 ? Math.min(maxSecondsRaw, 180) : SHORTS_MAX_SECONDS;
    
    let continuation = url.searchParams.get("continuation") || url.searchParams.get("token") || null;
    if (continuation) {
      continuation = continuation.replace(/ /g, "+");
    }

    const shortMatch = path.match(/^\/api\/v1\/shorts\/([a-zA-Z0-9_-]{11})/);
    if (shortMatch) shortId = shortMatch[1];
    
    const isShortsRoot = path === "/api/v1/shorts" || path === "/api/v1/shorts/";
    const isShortsRequest = !!(shortId || isShortsRoot || url.searchParams.has("shorts") || url.searchParams.has("short"));

    // 2. 通常メモリキャッシュ判定 (0ms)
    const cachedData = getCached(cacheKey);
    if (cachedData && request.method === "GET") {
      return new Response(JSON.stringify(cachedData), { headers: corsHeaders });
    }

    // 3. Cloudflareグローバルエッジキャッシュ判定
    const cache = caches.default;
    const cacheUrl = new URL(request.url);
    const edgeCached = await cache.match(cacheUrl.toString());
    if (edgeCached && request.method === "GET") {
      return edgeCached;
    }

    // ★ レスポンス生成
    let responseData = null;

    if (isShortsRequest) {
      const targetId = shortId || await getShortsSeed();
      
      // ★ 改善版: 複数のショートを取得
      responseData = await fetchShortsFeed(targetId, {
        limit: shortsLimit,
        continuation,
        maxSeconds: shortsMaxSeconds
      });
      
      // 次ページを裏で先読み
      if (responseData.continuation) {
        triggerShortsPrefetch(ctx, targetId, responseData.continuation, shortsLimit, shortsMaxSeconds);
      }
      
      // キャッシュに保存
      if (responseData.sequence && responseData.sequence.length > 0) {
        setCache(cacheKey, responseData);
      }
    } else {
      // その他のリクエスト
      responseData = {
        error: "Unsupported endpoint",
        availableEndpoints: [
          "/api/v1/shorts/{videoId}",
          "/api/v1/shorts?short={videoId}&limit=40"
        ]
      };
    }

    return new Response(JSON.stringify(responseData), { headers: corsHeaders });
  }
};
