// =======================================================
// 超高速インメモリ ＆ ハンドル永久キャッシュ (0ms即引き)
// 改善版: 動画詳細・関連動画・タイトル取得の堅牢性向上
// =======================================================
const MEMORY_CACHE = new Map();
const CACHE_TTL_MS = 10 * 60 * 1000;
const STALE_MAX_MS = 60 * 60 * 1000;
const CHANNEL_ID_CACHE = new Map();
const REFRESHING = new Set();
let CACHE_ORIGIN = "https://cache.local";

const INNERTUBE_API_KEY = "AIzaSyAO_FJ2SlqU8Q4STEHLGCilw_Y9_11qcW8";
const INNERTUBE_TIMEOUT_MS = 8000;

function getCached(key) {
  const item = MEMORY_CACHE.get(key);
  if (item && Date.now() - item.time < CACHE_TTL_MS) {
    return item.data;
  }
  return null;
}

function getStale(key) {
  const item = MEMORY_CACHE.get(key);
  if (item && Date.now() - item.time < STALE_MAX_MS) {
    return item.data;
  }
  return null;
}

function setCache(key, data) {
  MEMORY_CACHE.delete(key);
  if (MEMORY_CACHE.size > 800) {
    const firstKey = MEMORY_CACHE.keys().next().value;
    MEMORY_CACHE.delete(firstKey);
  }
  MEMORY_CACHE.set(key, { data, time: Date.now() });
}

// =======================================================
// ★ ユーティリティ関数
// =======================================================
function parseCount(str) {
  if (!str) return 0;
  const num = parseInt(str.replace(/[^0-9]/g, ""), 10);
  return isNaN(num) ? 0 : num;
}

function fixUrl(url) {
  if (!url) return "";
  if (url.startsWith("http")) return url;
  if (url.startsWith("//")) return "https:" + url;
  return url;
}

function escapeHtml(text) {
  if (!text) return "";
  const map = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
  return text.replace(/[&<>"']/g, m => map[m]);
}

function textOf(t) {
  if (!t) return "";
  if (typeof t === "string") return t;
  if (typeof t.simpleText === "string") return t.simpleText;
  if (typeof t.content === "string") return t.content;
  if (Array.isArray(t.runs)) return t.runs.map(r => r?.text || "").join("");
  return "";
}

function makeReliableThumbnails(videoId) {
  return [
    { url: `https://i.ytimg.com/vi/${videoId}/default.jpg`, width: 120, height: 90 },
    { url: `https://i.ytimg.com/vi/${videoId}/mqdefault.jpg`, width: 320, height: 180 },
    { url: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`, width: 480, height: 360 },
    { url: `https://i.ytimg.com/vi/${videoId}/sddefault.jpg`, width: 640, height: 480 }
  ];
}

function makeNocookieEmbedUrl(videoId) {
  return `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&modestbranding=1`;
}

// =======================================================
// ★ YouTube InnerTube通信エンジン
// =======================================================
async function callInnerTube(endpoint, payload, retryCount = 0, customSignal = null, timeoutMs = INNERTUBE_TIMEOUT_MS) {
  const url = `https://www.youtube.com/youtubei/v1/${endpoint}?key=${INNERTUBE_API_KEY}&prettyPrint=false`;
  
  const headers = {
    "Content-Type": "application/json",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "X-YouTube-Client-Name": "1",
    "X-YouTube-Client-Version": "2.20240625.01.00",
    "Origin": "https://www.youtube.com"
  };

  const body = {
    context: {
      client: {
        hl: "ja",
        gl: "JP",
        clientName: "WEB",
        clientVersion: "2.20240625.01.00",
        utcOffsetMinutes: 540
      }
    },
    ...payload
  };

  const ac = new AbortController();
  const timer = setTimeout(() => ac.abort(), timeoutMs);
  const forwardAbort = () => ac.abort();
  if (customSignal) {
    if (customSignal.aborted) ac.abort();
    else customSignal.addEventListener("abort", forwardAbort, { once: true });
  }

  try {
    const res = await fetch(url, {
      method: "POST",
      keepalive: true,
      headers: headers,
      body: JSON.stringify(body),
      signal: ac.signal
    });

    if ((res.status === 403 || res.status === 429) && retryCount < 2) {
      await new Promise(r => setTimeout(r, 60));
      return await callInnerTube(endpoint, payload, retryCount + 1, customSignal, timeoutMs);
    }

    if (!res.ok) {
      const errText = await res.text();
      throw new Error(`YouTube API Error [${endpoint}]: HTTP ${res.status}`);
    }

    return await res.json();
  } catch (err) {
    if (retryCount < 1 && !customSignal?.aborted && !ac.signal.aborted) {
      await new Promise(r => setTimeout(r, 60));
      return await callInnerTube(endpoint, payload, retryCount + 1, customSignal, timeoutMs);
    }
    throw err;
  } finally {
    clearTimeout(timer);
    if (customSignal) customSignal.removeEventListener("abort", forwardAbort);
  }
}

// =======================================================
// ★ チャンネルID解決
// =======================================================
async function resolveChannelId(input) {
  if (!input) return "";
  const clean = input.trim();
  if (clean.startsWith("UC") && clean.length === 24) return clean;

  const handle = clean.startsWith("@") ? clean : "@" + clean;
  if (CHANNEL_ID_CACHE.has(handle)) {
    return CHANNEL_ID_CACHE.get(handle);
  }

  try {
    const res = await callInnerTube("navigation/resolve_url", { url: `https://www.youtube.com/${handle}` });
    const resolvedId = res.endpoint?.browseEndpoint?.browseId;
    if (resolvedId && resolvedId.startsWith("UC")) {
      CHANNEL_ID_CACHE.set(handle, resolvedId);
      return resolvedId;
    }
  } catch (e) {}

  return "";
}

// =======================================================
// ★ ビデオレンダラー抽出 (複数形式対応・改善版)
// =======================================================
function extractVideoRenderer(node) {
  if (!node || typeof node !== "object") return null;

  let videoId = null;
  let title = "";
  let author = "";
  let authorId = "";
  let thumbnail = "";
  let duration = "";
  let views = "";
  let isShort = false;
  let isLive = false;

  // ★ 複数のレンダラー形式に対応
  const vr = 
    node.videoRenderer ||
    node.compactVideoRenderer ||
    node.gridVideoRenderer ||
    node.playlistVideoRenderer ||
    node.reelItemRenderer ||
    (node.shortsLockupViewModel ? node : null) ||
    (node.lockupViewModel ? node : null);

  if (!vr) return null;

  // ★ videoId取得 (複数の場所を確認)
  videoId = 
    vr.videoId ||
    vr.contentId ||
    node.videoId ||
    null;

  if (!videoId || typeof videoId !== "string" || videoId.length !== 11) return null;

  // ★ タイトル取得 (複数の形式に対応)
  const titleObj = 
    vr.title ||
    vr.headline ||
    node.metadata?.lockupMetadataViewModel?.title ||
    null;

  if (titleObj) {
    title = textOf(titleObj);
  }

  // ★ Author取得
  const authorObj = 
    vr.shortBylineText ||
    vr.longBylineText ||
    vr.ownerText ||
    vr.channelTitleText ||
    (node.metadata?.lockupMetadataViewModel?.metadataRows?.[0]?.metadataParts?.[0]?.text);

  if (authorObj) {
    author = textOf(authorObj);
    // authorIdを取得
    if (vr.shortBylineText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId) {
      authorId = vr.shortBylineText.runs[0].navigationEndpoint.browseEndpoint.browseId;
    } else if (vr.longBylineText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId) {
      authorId = vr.longBylineText.runs[0].navigationEndpoint.browseEndpoint.browseId;
    }
  }

  // ★ サムネイル取得 (複数の場所を確認)
  const thumbnails = 
    vr.thumbnail?.thumbnails ||
    node.contentImage?.thumbnailViewModel?.image?.sources ||
    [];

  if (thumbnails.length > 0) {
    thumbnail = fixUrl(thumbnails[thumbnails.length - 1].url);
  } else {
    thumbnail = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
  }

  // ★ 長さ取得
  const lengthText = 
    vr.lengthText?.simpleText ||
    vr.lengthText?.runs?.map(r => r.text).join("") ||
    "";

  duration = lengthText;

  // ★ 再生数取得
  const viewCountText = 
    vr.viewCountText?.simpleText ||
    vr.viewCountText?.runs?.map(r => r.text).join("") ||
    (node.metadata?.lockupMetadataViewModel?.metadataRows?.[1]?.metadataParts?.[0]?.text?.content || "");

  views = viewCountText;

  // ★ Short/Live判定
  if (vr.reelItemRenderer) {
    isShort = true;
  } else if (node.shortsLockupViewModel) {
    isShort = true;
  } else if (vr.videoRenderer?.badges?.some(b => 
    b.metadataBadgeRenderer?.label?.includes("Short") || 
    b.metadataBadgeRenderer?.label?.includes("ショート")
  )) {
    isShort = true;
  }

  if (vr.videoRenderer?.badges?.some(b => 
    b.metadataBadgeRenderer?.label?.includes("LIVE") ||
    b.metadataBadgeRenderer?.style?.includes("BADGE_STYLE_TYPE_LIVE")
  )) {
    isLive = true;
  }

  return {
    type: isLive ? "live" : (isShort ? "short" : "video"),
    videoId: videoId,
    title: title,
    author: author,
    authorId: authorId,
    thumbnail: thumbnail,
    videoThumbnails: thumbnails.length > 0 ? thumbnails.map(t => ({
      url: fixUrl(t.url),
      width: t.width || 320,
      height: t.height || 180
    })) : makeReliableThumbnails(videoId),
    duration: duration,
    views: views,
    isShort: isShort,
    isLive: isLive
  };
}

// =======================================================
// ★ 継続トークン抽出
// =======================================================
function extractContinuationToken(data) {
  if (!data) return null;
  function scan(node, depth = 0) {
    if (!node || typeof node !== "object" || depth > 15) return null;
    if (node.continuationItemRenderer?.continuationEndpoint?.continuationCommand?.token) {
      return node.continuationItemRenderer.continuationEndpoint.continuationCommand.token;
    }
    if (Array.isArray(node)) {
      for (const item of node) {
        const result = scan(item, depth + 1);
        if (result) return result;
      }
    } else {
      for (const key of Object.keys(node)) {
        if (key !== "trackingParams") {
          const result = scan(node[key], depth + 1);
          if (result) return result;
        }
      }
    }
    return null;
  }
  return scan(data);
}

// =======================================================
// ★ 動画詳細取得 (改善版: 関連動画・コメント対応)
// =======================================================
async function fetchVideoDetails(videoId, limit = 15, continuationToken = null) {
  const timeoutController = new AbortController();
  const timeoutId = setTimeout(() => timeoutController.abort(), 5000);

  try {
    const payload = continuationToken ? 
      { continuation: continuationToken } : 
      { videoId: videoId };

    const videoData = await callInnerTube("next", payload, 0, timeoutController.signal);

    if (!videoData) {
      throw new Error("No video data returned");
    }

    let primaryInfo = null;
    let secondaryInfo = null;
    let title = "";
    let description = "";
    let author = "";
    let authorId = "";
    let viewCount = 0;
    let publishedText = "";
    const recommendedVideos = [];
    const seenIds = new Set();
    seenIds.add(videoId);

    // ★ 深いスキャンで情報を抽出
    function scanVideoData(node, depth = 0) {
      if (!node || typeof node !== "object" || depth > 25) return;

      // 動画主要情報
      if (node.videoPrimaryInfoRenderer) {
        primaryInfo = node.videoPrimaryInfoRenderer;
        if (primaryInfo.title?.runs) {
          title = primaryInfo.title.runs.map(r => r.text).join("");
        }
        if (primaryInfo.viewCount?.videoViewCountRenderer?.viewCount?.simpleText) {
          viewCount = parseCount(primaryInfo.viewCount.videoViewCountRenderer.viewCount.simpleText);
        }
        if (primaryInfo.dateText?.simpleText) {
          publishedText = primaryInfo.dateText.simpleText;
        }
      }

      // 動画副情報
      if (node.videoSecondaryInfoRenderer) {
        secondaryInfo = node.videoSecondaryInfoRenderer;
        if (secondaryInfo.attributedDescription?.content) {
          description = secondaryInfo.attributedDescription.content;
        } else if (secondaryInfo.description?.runs) {
          description = secondaryInfo.description.runs.map(r => r.text).join("");
        }
        const channelOwner = secondaryInfo.owner?.videoOwnerRenderer;
        if (channelOwner) {
          author = channelOwner.title?.runs?.[0]?.text || "";
          authorId = channelOwner.navigationEndpoint?.browseEndpoint?.browseId || "";
        }
      }

      // 関連動画取得
      if (recommendedVideos.length < limit) {
        const v = extractVideoRenderer(node);
        if (v && v.videoId && !seenIds.has(v.videoId)) {
          seenIds.add(v.videoId);
          recommendedVideos.push(v);
        }
      }

      if (Array.isArray(node)) {
        for (let i = 0; i < node.length; i++) {
          scanVideoData(node[i], depth + 1);
        }
      } else {
        for (const key of Object.keys(node)) {
          if (key !== "trackingParams" && key !== "clickTrackingParams") {
            scanVideoData(node[key], depth + 1);
          }
        }
      }
    }

    scanVideoData(videoData);

    // ★ タイトルが取得できない場合の代替
    if (!title && videoData.metadata?.videoDetails?.title) {
      title = videoData.metadata.videoDetails.title;
    }
    if (!title && videoData.metadata?.metadataRowContainer?.metadataRowContainerRenderer?.rows?.[0]) {
      title = textOf(videoData.metadata.metadataRowContainer.metadataRowContainerRenderer.rows[0].metadataRowRenderer?.title);
    }

    // ★ Authorが取得できない場合の代替
    if (!author && videoData.metadata?.videoDetails?.author) {
      author = videoData.metadata.videoDetails.author;
    }
    if (!authorId && videoData.metadata?.videoDetails?.channelId) {
      authorId = videoData.metadata.videoDetails.channelId;
    }

    return {
      type: "video",
      videoId: videoId,
      title: title || "Untitled",
      description: description,
      descriptionHtml: escapeHtml(description).replace(/\n/g, "<br>"),
      author: author,
      authorId: authorId,
      authorUrl: authorId ? `/channel/${authorId}` : "",
      viewCount: viewCount,
      publishedText: publishedText,
      thumbnail: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
      videoThumbnails: makeReliableThumbnails(videoId),
      embedUrl: makeNocookieEmbedUrl(videoId),
      recommendedVideos: recommendedVideos,
      continuation: extractContinuationToken(videoData),
      timestamp: Date.now()
    };
  } catch (e) {
    console.error("Video fetch error:", e.message);
    // ★ フォールバック: 最小限の情報は返す
    return {
      type: "video",
      videoId: videoId,
      title: "Video (Details unavailable)",
      description: "",
      author: "Unknown",
      authorId: "",
      viewCount: 0,
      thumbnail: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
      videoThumbnails: makeReliableThumbnails(videoId),
      embedUrl: makeNocookieEmbedUrl(videoId),
      recommendedVideos: [],
      error: e.message
    };
  } finally {
    clearTimeout(timeoutId);
  }
}

// =======================================================
// ★ 検索API (改善版)
// =======================================================
async function fetchSearchResults(query, limit = 30, continuation = null, filter = "all") {
  try {
    const payload = continuation ? 
      { continuation: continuation } : 
      { query: query };

    const searchData = await callInnerTube("search", payload);
    
    const results = [];
    const seenIds = new Set();
    let nextContinuation = null;

    function scanSearch(node, depth = 0) {
      if (!node || typeof node !== "object" || results.length >= limit || depth > 20) return;

      if (!nextContinuation && node.continuationItemRenderer?.continuationEndpoint?.continuationCommand?.token) {
        nextContinuation = node.continuationItemRenderer.continuationEndpoint.continuationCommand.token;
      }

      const v = extractVideoRenderer(node);
      if (v && v.videoId && !seenIds.has(v.videoId)) {
        let isMatch = false;
        if (filter === "all") isMatch = true;
        else if (filter === "shorts") isMatch = v.isShort;
        else if (filter === "live") isMatch = v.isLive;
        else if (filter === "videos") isMatch = !v.isShort && !v.isLive;

        if (isMatch) {
          seenIds.add(v.videoId);
          results.push(v);
        }
      }

      if (node.playlistRenderer && !seenIds.has(node.playlistRenderer.playlistId)) {
        const pr = node.playlistRenderer;
        seenIds.add(pr.playlistId);
        results.push({
          type: "playlist",
          title: pr.title?.simpleText || pr.title?.runs?.map(r => r.text).join("") || "Playlist",
          playlistId: pr.playlistId,
          author: pr.shortBylineText?.runs?.[0]?.text || "",
          authorId: pr.shortBylineText?.runs?.[0]?.navigationEndpoint?.browseEndpoint?.browseId || "",
          videoCount: parseCount(pr.videoCount || "0"),
          thumbnail: fixUrl(pr.thumbnail?.thumbnails?.[pr.thumbnail.thumbnails.length - 1]?.url)
        });
      }

      if (Array.isArray(node)) {
        for (let i = 0; i < node.length; i++) {
          scanSearch(node[i], depth + 1);
        }
      } else {
        for (const key of Object.keys(node)) {
          if (key !== "trackingParams") {
            scanSearch(node[key], depth + 1);
          }
        }
      }
    }

    scanSearch(searchData);

    return {
      query: query,
      estimatedResults: 0,
      results: results,
      continuation: nextContinuation,
      filter: filter
    };
  } catch (e) {
    console.error("Search error:", e.message);
    return {
      query: query,
      results: [],
      continuation: null,
      error: e.message
    };
  }
}

