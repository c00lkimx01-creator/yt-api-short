      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      event.target.classList.add('active');
      document.getElementById('btnNext').style.display = 'none';
      lastToken = null;
      document.getElementById('videoDetailsView').style.display = 'none';
      document.getElementById('shortsTestView').style.display = 'none';

      if (m === 'search') {
        document.getElementById('pathInput').value = '/api/v1/search?q=Hikakin&limit=30';
      } else if (m === 'video') {
        document.getElementById('pathInput').value = '/api/v1/videos/SX_ViT4Ra7k';
      } else if (m === 'shorts') {
        document.getElementById('pathInput').value = '/api/v1/shorts/9f1rHt0W_Ak?limit=40';
      }
      fetchApi();
    }

    function renderSequence(list, append) {
      var box = document.getElementById('sequenceList');
      if (!append) { box.textContent = ''; shortsState.seen = {}; }
      (list || []).forEach(function (s) {
        if (shortsState.seen[s.id]) return;
        shortsState.seen[s.id] = true;
        var card = document.createElement('div');
        card.className = 'seq-card';
        card.onclick = function () {
          document.getElementById('pathInput').value = '/api/v1/shorts/' + s.id + '?limit=40';
          fetchApi();
        };
        var img = document.createElement('img');
        img.src = s.thumbnail || '';
        img.loading = 'lazy';
        var info = document.createElement('div');
        var b = document.createElement('b');
        b.textContent = s.title || s.id;
        var sp = document.createElement('span');
        sp.style.color = '#aaa';
        sp.textContent = s.author || '';
        info.appendChild(b);
        info.appendChild(document.createElement('br'));
        info.appendChild(sp);
        card.appendChild(img);
        card.appendChild(info);
        box.appendChild(card);
      });
      document.getElementById('sequenceCount').textContent = String(box.children.length);
    }

    async function fetchApi() {
      const p = document.getElementById('pathInput').value.trim();
      const resEl = document.getElementById('result');
      const videoDetailsView = document.getElementById('videoDetailsView');
      const shortsView = document.getElementById('shortsTestView');
      const t0 = performance.now();
      resEl.textContent = '取得中...';
      videoDetailsView.style.display = 'none';
      shortsView.style.display = 'none';

      try {
        const res = await fetch('${origin}' + p);
        const json = await res.json();
        const t1 = performance.now();
        resEl.textContent = '【応答時間: ' + Math.round(t1 - t0) + ' ms】\\n' + JSON.stringify(json, null, 2);
        lastToken = json.continuation || null;
        document.getElementById('btnNext').style.display = lastToken ? 'inline-block' : 'none';

        // 動画詳細表示
        if (json.type === 'video' && json.videoId) {
          lastVideoId = json.videoId;
          videoDetailsView.style.display = 'block';
          document.getElementById('videoTitle').textContent = json.title || 'Unknown';
          document.getElementById('videoAuthor').textContent = json.author || 'Unknown';
          document.getElementById('videoViews').textContent = (json.viewCount || 0).toLocaleString();
          document.getElementById('videoPublished').textContent = json.publishedText || 'N/A';
          document.getElementById('videoLink').href = 'https://youtube.com/watch?v=' + json.videoId;
          
          const recList = document.getElementById('recommendedList');
          recList.innerHTML = '';
          if (json.recommendedVideos && Array.isArray(json.recommendedVideos)) {
            document.getElementById('recommendedCount').textContent = json.recommendedVideos.length;
            json.recommendedVideos.forEach(video => {
              const card = document.createElement('div');
              card.className = 'rec-card';
              card.innerHTML = '<img src="' + (video.thumbnail || '') + '" alt=""><div class="rec-card-title">' + escapeHtml(video.title || 'Untitled') + '</div><div class="rec-card-author">' + escapeHtml(video.author || '') + '</div>';
              card.onclick = () => {
                if (video.videoId) {
                  document.getElementById('pathInput').value = '/api/v1/videos/' + video.videoId;
                  fetchApi();
                }
              };
              recList.appendChild(card);
            });
          }
        }

        // ショート表示
        if (json.type === 'shorts' && json.current) {
          shortsView.style.display = 'block';
          document.getElementById('shortsIframe').src = json.current.embedUrl;
          document.getElementById('shortTitleDisplay').textContent = json.current.title;
          document.getElementById('shortAuthorDisplay').textContent = json.current.author;
          shortsState.id = json.current.id;
          shortsState.continuation = json.continuation || null;
          renderSequence(json.sequence, false);
        }

        // 検索結果はJSON表示のみ
      } catch (e) {
        resEl.textContent = 'エラー: ' + e.message;
      }
    }

    function escapeHtml(text) {
      var div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    async function loadNextPage() {
      if (!lastToken) return;
      const resEl = document.getElementById('result');
      resEl.textContent = '次ページ取得中...';
      const t0 = performance.now();

      let endpoint = '';
      if (currentMode === 'search') {
        endpoint = '/api/v1/search?q=' + encodeURIComponent(lastSearchQuery) + '&continuation=' + encodeURIComponent(lastToken);
      } else if (currentMode === 'video') {
        endpoint = '/api/v1/videos/' + lastVideoId + '?continuation=' + encodeURIComponent(lastToken);
      } else if (currentMode === 'shorts') {
        endpoint = '/api/v1/shorts/' + shortsState.id + '?limit=40&continuation=' + encodeURIComponent(lastToken);
      }

      try {
        const res = await fetch('${origin}' + endpoint);
        const json = await res.json();
        const t1 = performance.now();
        resEl.textContent = '【追加読込時間: ' + Math.round(t1 - t0) + ' ms】\\n' + JSON.stringify(json, null, 2);
        lastToken = json.continuation || null;
        document.getElementById('btnNext').style.display = lastToken ? 'inline-block' : 'none';
        
        if (currentMode === 'video' && json.recommendedVideos) {
          const recList = document.getElementById('recommendedList');
          json.recommendedVideos.forEach(video => {
            const card = document.createElement('div');
            card.className = 'rec-card';
            card.innerHTML = '<img src="' + (video.thumbnail || '') + '" alt=""><div class="rec-card-title">' + escapeHtml(video.title || 'Untitled') + '</div><div class="rec-card-author">' + escapeHtml(video.author || '') + '</div>';
            card.onclick = () => {
              if (video.videoId) {
                document.getElementById('pathInput').value = '/api/v1/videos/' + video.videoId;
                fetchApi();
              }
            };
            recList.appendChild(card);
          });
        }
        
        if (currentMode === 'shorts' && json.sequence) renderSequence(json.sequence, true);
      } catch (e) {
        resEl.textContent = '追加読み込みエラー: ' + e.message;
      }
    }

    // 初期表示
    fetchApi();
  </script>
</body>
</html>`;
}

// =======================================================
// ★ メインエントリーポイント
// =======================================================
export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    CACHE_ORIGIN = url.origin;

    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers": "*",
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400",
      "Referrer-Policy": "no-referrer"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    const path = url.pathname;
    const cacheKey = url.pathname + url.search;

    // ★ HTMLデモUI: APIパラメータの無いブラウザアクセスは、HTMLを先に返す
    const acceptsHtml = (request.headers.get("Accept") || "").includes("text/html");
    const isApiRequest = !!(
      url.searchParams.has("q") ||
      url.searchParams.has("search") ||
      url.searchParams.has("videoId") ||
      url.searchParams.has("v") ||
      url.searchParams.has("continuation") ||
      url.searchParams.has("token")
    );

    if (request.method === "GET" && acceptsHtml && !isApiRequest && path === "/") {
      return new Response(renderDemoHtml(url.origin), {
        headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-cache" }
      });
    }

    // パラメータ解析
    const videoId = url.searchParams.get("v") || url.searchParams.get("videoId");
    const query = url.searchParams.get("q") || url.searchParams.get("search");
    const channelId = url.searchParams.get("channel") || url.searchParams.get("channelId");
    const tab = (url.searchParams.get("tab") || "videos").toLowerCase();
    const sort = (url.searchParams.get("sort") || "latest").toLowerCase();
    const filter = (url.searchParams.get("filter") || url.searchParams.get("type") || "all").toLowerCase();
    const limit = Math.min(parseInt(url.searchParams.get("limit") || "30", 10) || 30, 100);
    
    let continuation = url.searchParams.get("continuation") || url.searchParams.get("token") || null;
    if (continuation) continuation = continuation.replace(/ /g, "+");

    // パスルーティング
    const videoMatch = path.match(/^\/api\/v1\/videos\/([a-zA-Z0-9_-]{11})/);
    if (videoMatch) {
      const vid = videoMatch[1];
      
      // メモリキャッシュ判定
      const cachedData = getCached(cacheKey);
      if (cachedData && request.method === "GET") {
        return new Response(JSON.stringify(cachedData), { headers: corsHeaders });
      }

      try {
        const responseData = await fetchVideoDetails(vid, limit, continuation);
        setCache(cacheKey, responseData);
        return new Response(JSON.stringify(responseData), { headers: corsHeaders });
      } catch (e) {
        return new Response(
          JSON.stringify({ error: e.message || "Unknown error", videoId: vid }),
          { status: 500, headers: { ...corsHeaders, "Cache-Control": "no-store" } }
        );
      }
    }

    // メモリキャッシュ判定
    const cachedData = getCached(cacheKey);
    if (cachedData && request.method === "GET") {
      return new Response(JSON.stringify(cachedData), { headers: corsHeaders });
    }

    try {
      let responseData = null;

      // ★ 検索API
      if (query) {
        responseData = await fetchSearchResults(query, limit, continuation, filter);
      }
      // ルート
      else if (path === "/" || path === "" || path === "/api/v1") {
        responseData = {
          message: "YouTube API Proxy - 動画詳細・HTML表示対応版",
          endpoints: [
            "/api/v1/videos/<videoId>         動画詳細・関連動画",
            "/api/v1/search?q=<query>&filter=shorts|live|videos|all",
            "/api/v1/channels/@<name>?tab=videos|shorts|live|playlists"
          ]
        };
      } else {
        responseData = { error: "Not found" };
      }

      // キャッシュ保存
      if (responseData && !responseData.error) {
        setCache(cacheKey, responseData);
      }

      return new Response(JSON.stringify(responseData), { headers: corsHeaders });

    } catch (e) {
      return new Response(
        JSON.stringify({ error: e.message || "Unknown error" }),
        { status: 500, headers: { ...corsHeaders, "Cache-Control": "no-store" } }
      );
    }
  }
};
